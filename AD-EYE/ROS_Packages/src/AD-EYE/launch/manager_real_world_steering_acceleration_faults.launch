<launch>
  <arg name="enable_manual_recovery" default="false"/>
  <arg name="enable_test_configuration_monitor" default="false"/>
  <arg name="test_configuration_profile" default="steering_acceleration_faults"/>
    <arg name="record_physical_commands" default="false"/>
    <arg name="use_recorded_inputs" default="false"/>
    <arg name="enable_goal_stop" default="false"/>
    <!-- Live steering and acceleration fault injection through both proxies. -->
    <include file="$(find adeye)/launch/manager_real_world.launch">
      <arg name="enable_manual_recovery" value="$(arg enable_manual_recovery)"/>
      <arg name="enable_test_configuration_monitor" value="$(arg enable_test_configuration_monitor)"/>
      <arg name="test_configuration_profile" value="$(arg test_configuration_profile)"/>
        <arg name="record_physical_commands" value="$(arg record_physical_commands)"/>
        <arg name="use_recorded_inputs" value="$(arg use_recorded_inputs)"/>
        <arg name="enable_goal_stop" value="$(arg enable_goal_stop)"/>

        <arg name="enable_steering_proxy" value="true"/>
        <arg name="enable_acceleration_proxy" value="true"/>

        <arg name="enable_steering_faults" value="true"/>
        <arg name="enable_acceleration_faults" value="true"/>
    </include>
</launch>
