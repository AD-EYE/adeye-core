<!-- -->
<launch>

    <include file="$(find can_vehicle)/launch/vic.launch"/>

    <env name="ROSCONSOLE_FORMAT" value="[${severity}] [${time}] [${node}]: ${message}"/>

    <arg name="lidar_source" default="RealWorld"/>
    <arg name="gnss_source" default="RealWorld"/>
    <arg name="camera_source" default="RealWorld"/>

    <param name="sensing/lidar_source" value="$(arg lidar_source)" />
    <param name="sensing/gnss_source" value="$(arg gnss_source)" />
    <param name="sensing/camera_source" value="$(arg gnss_source)" />


    <arg name="test_automation" default="false"/>
    <rosparam>
        use_sim_time: false
    </rosparam>
    <group if="$(arg test_automation)">
        <rosparam>
            test_automation: true
        </rosparam>
    </group>

    <node
            type="manager.py"
            pkg="adeye"
            name="manager"
            respawn="false"
            output="screen"
    >
        <!-- CAN interface publishes speed and steering on typed topics. -->
        <param name="vehicle_status_source" value="can_topics" />
        <param name="vehicle_speed_topic" value="/current_velocity_phy" />
        <param name="vehicle_steering_angle_topic" value="/sending_angle" />
        <!-- AD-EYE fault-injection change: physical direct actuator routing. -->
        <param name="actuator_fault_path" value="physical_topics" />
    </node>

    <!--<node pkg="nmea_navsat_driver" type="nmea_serial_driver" name="navsat_driver" respawn="true">
        <param name="port" value="/dev/ttyACM0"/>
        <param name="baud" value="9600"/>
    </node>-->

    <include file="$(find ouster_ros)/ouster.launch">
        <arg name="sensor_hostname" value="os-122132000155.local"/>
        <arg name="viz" value="false"/>
        <arg name="metadata" value="/home/adeye/ouster-metadata.json"/>
    </include>


    <!--<node pkg="adeye" type="camera_gmsl_publisher" name="camera_gmsl_publisher" respawn="true"/>-->


    <node
        pkg="adeye"
        type="ctrl_cmd_republisher"
        name="ctrl_cmd_republisher"
    >
        <!-- AD-EYE fault-injection change: conservative physical limits. -->
        <param name="fault_timeout_s" value="5.0" />
        <param name="max_steering_offset" value="1.0" />
        <param name="max_steering_saturation" value="10.0" />
        <param name="max_steering_oscillation" value="0.5" />
    </node>

    <node
            type="vehicle_controller"
            pkg="adeye"
            name="vehicle_controller"
            respawn="false"
            output="screen"
    >
        <param name="topic_velocity_current" value="/current_velocity_phy"/>
        <param name="topic_acceleration_request" value="/acceleration_requested_phy"/>
        <param name="topic_steering_request" value="/old_steering_requested_phy"/>
        <!-- AD-EYE fault-injection change: conservative physical limits. -->
        <param name="fault_timeout_s" value="5.0" />
        <param name="max_acceleration_offset" value="0.2" />
        <param name="max_acceleration_saturation" value="0.5" />
        <param name="max_acceleration_oscillation" value="0.1" />
    </node>

    <node pkg="topic_tools" type="relay" name="relay_velocity" args="/current_velocity_phy /current_velocity"/>
    <node pkg="topic_tools" type="relay" name="points_raw_relay" output="log" args="/os_cloud_node/points /points_raw"/>

</launch>
