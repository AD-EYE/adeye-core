<launch>
  <arg name="enable_manual_recovery" default="false"/>
  <arg name="enable_test_configuration_monitor" default="false"/>
  <arg name="test_configuration_profile" default="sensor_faults"/>
  <!-- Physical sensor-fault module. LiDAR has one clear proxy path:
       /os_cloud_node/points -> sensor fault manager -> /points_raw. -->

  <arg name="gnss_input_topic" default="/fix" />
  <arg name="faulted_gnss_topic" default="/adeye/fault_injection/fix" />
  <arg name="lidar_input_topic" default="/os_cloud_node/points" />
  <arg name="lidar_output_topic" default="/points_raw" />
  <arg name="sensor_input_timeout_s" default="2.0" />
  <arg name="max_gnss_bias_m" default="5.0" />
  <arg name="max_lidar_drop_every_n" default="20" />
  <arg name="max_lidar_timestamp_offset_s" default="0.2" />
  <arg name="use_recorded_inputs" default="false" />
  <arg name="enable_steering_faults" default="false" />
  <arg name="enable_acceleration_faults" default="false" />
  <arg name="record_physical_commands" default="false" />
  <arg name="enable_goal_stop" default="false" />

  <include file="$(find adeye)/launch/manager_real_world.launch">
    <arg name="enable_manual_recovery" value="$(arg enable_manual_recovery)"/>
    <arg name="enable_test_configuration_monitor" value="$(arg enable_test_configuration_monitor)"/>
    <arg name="test_configuration_profile" value="$(arg test_configuration_profile)"/>
    <arg name="use_recorded_inputs" value="$(arg use_recorded_inputs)" />
    <arg name="record_physical_commands" value="$(arg record_physical_commands)" />
    <arg name="enable_goal_stop" value="$(arg enable_goal_stop)" />
    <arg name="enable_steering_proxy" value="$(arg enable_steering_faults)" />
    <arg name="enable_acceleration_proxy" value="$(arg enable_acceleration_faults)" />
    <arg name="enable_steering_faults" value="$(arg enable_steering_faults)" />
    <arg name="enable_acceleration_faults" value="$(arg enable_acceleration_faults)" />
    <arg name="steering_producer_output_topic" value="$(eval '/nominal/steering_requested_phy' if arg('enable_steering_faults') else '/steering_requested_phy')" />
    <arg name="acceleration_producer_output_topic" value="$(eval '/nominal/acceleration_requested_phy' if arg('enable_acceleration_faults') else '/acceleration_requested_phy')" />
    <arg name="enable_default_points_raw_relay" value="false" />
  </include>

  <node pkg="adeye"
        type="SensorFaultInjectionManager.py"
        name="sensor_fault_injection_manager"
        output="screen">
    <param name="gnss_input_topic" value="$(arg gnss_input_topic)" />
    <param name="enable_gnss" value="true" />
    <param name="enable_lidar" value="true" />
    <param name="gnss_output_topic" value="$(arg faulted_gnss_topic)" />
    <param name="lidar_input_topic" value="$(arg lidar_input_topic)" />
    <param name="lidar_output_topic" value="$(arg lidar_output_topic)" />
    <param name="sensor_input_timeout_s" value="$(arg sensor_input_timeout_s)" />
    <param name="max_gnss_bias_m" value="$(arg max_gnss_bias_m)" />
    <param name="max_lidar_drop_every_n" value="$(arg max_lidar_drop_every_n)" />
    <param name="max_lidar_timestamp_offset_s" value="$(arg max_lidar_timestamp_offset_s)" />
  </node>

  <!-- Existing GNSS conversion, now consuming the faulted NavSatFix stream. -->
  <group>
    <remap from="/fix" to="$(arg faulted_gnss_topic)" />
    <include file="$(find adeye)/launch/gnss_broadcaster.launch" />
  </group>
</launch>
